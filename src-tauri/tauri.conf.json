{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JM Operations",
  "version": "1.0.0",
  "identifier": "com.jurukurmahabob.jmc",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare-web.mjs",
    "beforeBuildCommand": "node scripts/prepare-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JM Operations",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
